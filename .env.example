# Copy to .env and fill in. Never commit .env.

# The web address the firm will use, e.g. smithlaw.yourcompany.com (DNS must point at this server).
DOMAIN=firm.example.com
DJANGO_ALLOWED_HOSTS=firm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://firm.example.com

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

TIME_ZONE=Africa/Harare

# Outgoing email for fee notes, statements and password resets (any SMTP provider).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Firm Name <accounts@firm.example.com>
# Receives error reports.
DJANGO_ADMIN_EMAILS=you@yourcompany.com

# Backups
BACKUP_HOUR=01
BACKUP_KEEP_DAYS=30
