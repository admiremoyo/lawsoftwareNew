{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LawPractice",
  "version": "1.0.0",
  "identifier": "com.lawpractice.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "LawPractice",
    "shortDescription": "Practice management and trust accounting for law firms",
    "longDescription": "Clients, matters, time recording, fee notes, diary and trust accounting that can never be overdrawn. Works on this computer on its own, or connected to your firm's LawPractice server.",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server/": "server/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
